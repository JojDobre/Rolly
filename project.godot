; Nastavenia projektu Godot 4.4

config_version=5

[application]

config/name="Gulicka"
config/description="Fyzikálna plošinovka s guličkou, ktorá zbiera hviezdy."
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://assets/npp/tiles/star.png"

[autoload]

GameState="*res://scripts/game_state.gd"
Content="*res://scripts/content.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

2d_physics/layer_1="svet"
2d_physics/layer_2="plosiny"
2d_physics/layer_3="hrac"
2d_physics/layer_4="moby"
2d_physics/layer_5="predmety"

[physics]

2d/default_gravity=1200.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.82, 0.95, 0.97, 1)
